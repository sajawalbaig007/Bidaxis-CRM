generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  csr
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role

  isActive Boolean @default(true)

  isOnline   Boolean   @default(false)
  lastActive DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads        Lead[]    @relation("AssignedLeads")
  callLogs     CallLog[] @relation("CSRCallLogs")
  reports      Report[]
  twoFAEnabled Boolean   @default(false)
  tokenVersion Int       @default(0)
}

model Lead {
  id       String  @id @default(cuid())
  name     String?
  company  String?
  phone    String?
  email    String?
  status   String  @default("pending")
  comments String?

  important  Boolean @default(false)
  interested Boolean @default(false)

  nextSchedule   String?
  nextTime       String?
  timezone       String?
  followUpNotes  String?
  followUpExpiry DateTime?

  interestedService String?
  projectTitle      String?
  projectDeadline   String?
  projectBudget     String?
  projectNotes      String?

  assignedTo     String
  uploadedFileId String?

  shuffleAttempts    Int @default(0)
  notInterestedCount Int @default(0)
  notPickedCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  csr        User        @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: Cascade)
  uploadFile UploadFile? @relation(fields: [uploadedFileId], references: [id])
  callLogs   CallLog[]
}

model CallLog {
  id       String  @id @default(cuid())
  leadId   String
  csrId    String
  status   String
  notes    String?
  duration Int?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  csr  User @relation("CSRCallLogs", fields: [csrId], references: [id], onDelete: Cascade)
}

model UploadFile {
  id            String   @id @default(cuid())
  fileName      String
  cloudinaryUrl String
  totalLeads    Int
  uploadedBy    String
  companyName   String?
  createdAt     DateTime @default(now())

  leads Lead[]
}

model Report {
  id          String  @id @default(cuid())
  reportName  String
  reportUrl   String
  reportType  String
  generatedBy String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  csr
}

model User {
  id           String    @id @default(cuid()) @map("_id")
  name         String
  email        String    @unique
  password     String
  role         Role
  csrCode      String?
  cnic         String?
  profilePic   String?
  isActive     Boolean   @default(true)
  isOnline     Boolean   @default(false)
  lastActive   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  twoFAEnabled Boolean   @default(false)
  tokenVersion Int       @default(0)
  activeSessionId String?
  lastLoginAt  DateTime?

  auditLogs      SecurityAuditLog[]
  accessHistory  AccessHistory[]

  leads        Lead[]               @relation("AssignedLeads")
  callLogs     CallLog[]            @relation("CSRCallLogs")
  reports      Report[]
  memberships  ConversationMember[]
  sentMessages Message[]            @relation("SentMessages")

  @@index([role])
  @@index([isActive])
  @@index([lastActive])
  @@index([role, isActive])
}

model Lead {
  id                 String    @id @default(cuid()) @map("_id")
  name               String?
  company            String?
  phone              String?
  email              String?
  status             String    @default("pending")
  comments           String?
  important          Boolean   @default(false)
  interested         Boolean   @default(false)
  nextSchedule       String?
  nextTime           String?
  timezone           String?
  followUpNotes      String?
  followUpExpiry     DateTime?
  interestedService  String?
  projectTitle       String?
  projectCode        String?
  projectDeadline    String?
  projectBudget      String?
  projectNotes       String?
  paidAmount         String?
  ownerName          String?
  projectScope       String?
  projectPhase       String?   @default("not_started")
  takeoffDeadline    String?
  pricingDeadline    String?
  qaDeadline         String?
  projectPayments    String?
  clientCode         String?
  state              String?
  isOldClient        Boolean   @default(false)
  assignedTo         String
  uploadedFileId     String?
  shuffleAttempts    Int       @default(0)
  notInterestedCount Int       @default(0)
  notPickedCount     Int       @default(0)
  hiddenOnMain       Boolean   @default(false)
  inBin              Boolean   @default(false)
  binReason          String?
  binPreviousStatus  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  csr         User        @relation("AssignedLeads", fields: [assignedTo], references: [id])
  uploadFile  UploadFile? @relation(fields: [uploadedFileId], references: [id])
  callLogs    CallLog[]
  notes       LeadNote[]
  subContacts SubContact[]

  @@index([assignedTo])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([company])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([assignedTo, status])
  @@index([company, status])
  @@index([status, assignedTo])
}

model LeadNote {
  id        String   @id @default(cuid()) @map("_id")
  text      String
  createdAt DateTime @default(now())
  leadId    String

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([leadId, createdAt])
}

model SubContact {
  id          String   @id @default(cuid()) @map("_id")
  leadId      String
  name        String
  designation String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model CallLog {
  id        String   @id @default(cuid()) @map("_id")
  leadId    String
  csrId     String
  status    String
  notes     String?
  duration  Int?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
  csr  User @relation("CSRCallLogs", fields: [csrId], references: [id])
}

model UploadSource {
  id        String   @id @default(cuid()) @map("_id")
  name      String   @unique
  createdAt DateTime @default(now())

  uploads UploadFile[]
}

model UploadFile {
  id             String   @id @default(cuid()) @map("_id")
  fileName       String
  cloudinaryUrl  String
  totalLeads     Int
  uploadedBy     String
  companyName    String?
  sourceId       String?
  uploadCategory String?  /* call-data | new-client | old-client | interested | important | active-projects */
  createdAt      DateTime @default(now())

  source UploadSource? @relation(fields: [sourceId], references: [id])
  leads  Lead[]

  @@index([sourceId])
  @@index([uploadCategory])
  @@index([createdAt])
}

model Conversation {
  id              String   @id @default(cuid()) @map("_id")
  type            String
  name            String?
  pinnedMessageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
  @@index([updatedAt])
}

model ConversationMember {
  id             String    @id @default(cuid()) @map("_id")
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  archivedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid()) @map("_id")
  conversationId String
  senderId       String
  text           String   @default("")
  type           String   @default("text")
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  fileMimeType   String?
  replyToId      String?
  mentions       String[] @default([])
  reactions      Json?
  editedAt       DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Report {
  id          String   @id @default(cuid()) @map("_id")
  reportName  String
  reportUrl   String
  reportType  String
  generatedBy String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [generatedBy], references: [id])
}

model SecurityAuditLog {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  email     String?
  action    String
  ip        String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model LoginLockout {
  id           String    @id @default(cuid()) @map("_id")
  key          String    @unique
  failCount    Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model LoginAttemptAlert {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @unique
  attemptId Int
  createdAt DateTime @default(now())
}

model RateLimitEntry {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  hits      Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model AccessHistory {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  email     String?
  ip        String?
  userAgent String?
  deviceId  String?
  browser   String?
  event     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

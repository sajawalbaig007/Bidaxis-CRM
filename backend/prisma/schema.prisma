generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  csr
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role

  csrCode  String?  @unique

  isActive Boolean @default(true)

  isOnline   Boolean   @default(false)
  lastActive DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads        Lead[]    @relation("AssignedLeads")
  callLogs     CallLog[] @relation("CSRCallLogs")
  reports      Report[]
  twoFAEnabled Boolean   @default(false)
  tokenVersion Int       @default(0)

  memberships  ConversationMember[]
  sentMessages Message[]            @relation("SentMessages")

  @@index([role])
  @@index([isActive])
  @@index([lastActive])
  @@index([role, isActive])
}

model Lead {
  id       String  @id @default(cuid())
  name     String?
  company  String?
  phone    String?
  email    String?
  status   String  @default("pending")
  comments String?

  important  Boolean @default(false)
  interested Boolean @default(false)

  nextSchedule   String?
  nextTime       String?
  timezone       String?
  followUpNotes  String?
  followUpExpiry DateTime?

  interestedService String?
  projectTitle      String?
  projectCode       String?
  projectDeadline   String?
  projectBudget     String?
  projectNotes      String?
  paidAmount        String?

  clientCode     String?
  state          String?
  isOldClient    Boolean @default(false)

  assignedTo     String
  uploadedFileId String?

  shuffleAttempts    Int @default(0)
  notInterestedCount Int @default(0)
  notPickedCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  csr        User        @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: Cascade)
  uploadFile UploadFile? @relation(fields: [uploadedFileId], references: [id])
  callLogs   CallLog[]

  @@index([assignedTo])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([company])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([assignedTo, status])
  @@index([company, status])
  @@index([status, assignedTo])
}

model CallLog {
  id       String  @id @default(cuid())
  leadId   String
  csrId    String
  status   String
  notes    String?
  duration Int?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  csr  User @relation("CSRCallLogs", fields: [csrId], references: [id], onDelete: Cascade)
}

model UploadFile {
  id            String   @id @default(cuid())
  fileName      String
  cloudinaryUrl String
  totalLeads    Int
  uploadedBy    String
  companyName   String?
  createdAt     DateTime @default(now())

  leads Lead[]
}

model Conversation {
  id        String   @id @default(cuid())
  type      String   // "direct" | "group"
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
  @@index([updatedAt])
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String  @id @default(cuid())
  conversationId String
  senderId       String
  text           String  @default("")
  type           String  @default("text") // "text" | "image" | "file" | "voice"
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  fileMimeType   String?

  replyToId    String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Report {
  id          String  @id @default(cuid())
  reportName  String
  reportUrl   String
  reportType  String
  generatedBy String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
}
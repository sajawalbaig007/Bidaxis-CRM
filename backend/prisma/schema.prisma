generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  csr
}

/**
 * ================= USER =================
 */

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role

  isActive   Boolean   @default(true)

  /* ── ONLINE PRESENCE ── */
  isOnline   Boolean   @default(false)
  lastActive DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /* ── RELATIONS ── */
  leads    Lead[]    @relation("AssignedLeads")
  callLogs CallLog[] @relation("CSRCallLogs")
  reports  Report[]
  twoFAEnabled  Boolean  @default(false)
tokenVersion  Int      @default(0)
}

/**
 * ================= LEAD =================
 */

model Lead {
  id      String  @id @default(cuid())
  name    String?
  company String?
  phone   String?
  email   String?
  status  String  @default("pending")
  comments String?

  /* ── FLAGS ── */
  important  Boolean @default(false)
  interested Boolean @default(false)

  /* ── FOLLOW UP ── */
  nextSchedule  String?
  nextTime      String?
  timezone      String?
  followUpNotes String?
  followUpExpiry DateTime?

  /* ── SERVICE & PROJECT ── */
  interestedService String?
  projectTitle      String?
  projectDeadline   String?
  projectBudget     String?
  projectNotes      String?

  /* ── ASSIGNMENT ── */
  assignedTo     String
  uploadedFileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /* ── RELATIONS ── */
  csr        User        @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: Cascade)
  uploadFile UploadFile? @relation(fields: [uploadedFileId], references: [id])
  callLogs   CallLog[]
}

/**
 * ================= CALL LOG =================
 */

model CallLog {
  id       String  @id @default(cuid())
  leadId   String
  csrId    String
  status   String
  notes    String?
  duration Int?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  csr  User @relation("CSRCallLogs", fields: [csrId], references: [id], onDelete: Cascade)
}

/**
 * ================= UPLOAD FILE =================
 */

model UploadFile {
  id            String @id @default(cuid())
  fileName      String
  cloudinaryUrl String
  totalLeads    Int
  uploadedBy    String
  companyName   String?
  createdAt DateTime @default(now())

  leads Lead[]
}

/**
 * ================= REPORT =================
 */

model Report {
  id          String  @id @default(cuid())
  reportName  String
  reportUrl   String
  reportType  String
  generatedBy String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
}

PORT=5000
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
SMTP_USER=
SMTP_PASS=
# Optional in production — required for OTP / login alert emails (Gmail app password).

# Client mail — up to 4 From accounts when staff click a client email.
# Hostinger domain mail: CRM_FROM_PASS = mailbox password (no app password).
# Gmail: CRM_FROM_PASS = 16-char App Password, not the login password.
# Optional SMTP (defaults: smtp.hostinger.com:465 for non-Gmail).
CRM_SMTP_HOST=smtp.hostinger.com
CRM_SMTP_PORT=465
CRM_SMTP_SECURE=true
CRM_FROM_EMAIL_1=
CRM_FROM_PASS_1=
CRM_FROM_NAME_1=
CRM_FROM_EMAIL_2=
CRM_FROM_PASS_2=
CRM_FROM_NAME_2=
CRM_FROM_EMAIL_3=
CRM_FROM_PASS_3=
CRM_FROM_NAME_3=
CRM_FROM_EMAIL_4=
CRM_FROM_PASS_4=
CRM_FROM_NAME_4=

# Optional local Ollama for "write this email for me" (no cloud AI).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
NODE_ENV=development

# JWT_SECRET: use a random string of at least 32 characters in production.
